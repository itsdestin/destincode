<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  WHY this file exists: electron-builder signs the Mac app with hardened runtime on,
  and our self-signed ("ad-hoc", identity '-') build only LAUNCHES because the
  entitlements grant disable-library-validation - without it macOS refuses to load
  the app's native modules (terminal, PDF text) and the app dies on users' Macs
  while CI's smoke test can stay green. Until 2026-09-04 these three keys came from
  electron-builder's own bundled template, which a future version could trim
  without any check going red. Owning the file pins them. Content is byte-for-byte
  what the template grants today, so nothing changes for users.
  electron-builder picks this file up by name from buildResources (assets/).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
