{
  "name": "youcoded",
  "version": "1.2.4",
  "description": "Desktop GUI for Claude Code with the YouCoded toolkit",
  "homepage": "https://github.com/itsdestin/youcoded",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/run-dev.js",
    "dev:main": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/main/pty-worker.js','dist/main/pty-worker.js')\" && electron .",
    "dev:renderer": "vite",
    "build": "tsc && node -e \"require('fs').cpSync('src/main/pty-worker.js','dist/main/pty-worker.js')\" && node -e \"require('fs').mkdirSync('dist/renderer/data',{recursive:true})\" && node -e \"require('fs').cpSync('src/renderer/data/skill-registry.json','dist/renderer/data/skill-registry.json')\" && vite build && electron-builder",
    "test": "vitest",
    "postinstall": "node scripts/patch-node-pty.js"
  },
  "keywords": [],
  "author": "itsdestin",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@mozilla/readability": "0.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.22",
    "bcryptjs": "^3.0.3",
    "chokidar": "^4.0.3",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "koffi": "^2.16.1",
    "linkedom": "0.18.13",
    "mammoth": "^1.12.0",
    "node-machine-id": "^1.1.12",
    "node-pty": "1.2.0-beta.12",
    "partysocket": "^1.1.16",
    "pdfjs-dist": "^5.7.284",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "turndown": "7.2.4",
    "ulid": "^3.0.2",
    "which": "^4.0.0",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/headless": "^6.0.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.4"
  }
}
